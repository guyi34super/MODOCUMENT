# Copy to .env (gitignored) and replace every placeholder with real values.
# Docker Compose loads .env automatically; the stack refuses to start without
# the required secrets below (see README.md Quick start and docker-compose.yml).
#
# Generate secrets:
#   POSTGRES_PASSWORD / MODOCUMENT_APP_DB_PASSWORD:  openssl rand -hex 24
#   MODOCUMENT_JWT_SECRET / MODOCUMENT_MFA_KEY:       openssl rand -base64 48
#
# Keep .env after first Postgres boot — passwords are fixed on the volume.

# --- Required (database + app crypto) ---
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-24>
MODOCUMENT_APP_DB_PASSWORD=<generate-with-openssl-rand-hex-24>
MODOCUMENT_JWT_SECRET=<generate-with-openssl-rand-base64-48>
MODOCUMENT_MFA_KEY=<generate-with-openssl-rand-base64-48>

# --- First-run administrators (empty AppUsers table only) ---
# Maker/checker needs two admins on a fresh install — set both pairs or neither.
# Mau team default bootstrap email (password: choose locally, never commit):
MODOCUMENT_BOOTSTRAP_ADMIN_EMAIL=team.mau.ai@gmail.com
MODOCUMENT_BOOTSTRAP_ADMIN_PASSWORD=<strong-temporary-password>
MODOCUMENT_BOOTSTRAP_SECOND_ADMIN_EMAIL=<second-admin@example.com>
MODOCUMENT_BOOTSTRAP_SECOND_ADMIN_PASSWORD=<another-strong-temporary-password>

# --- Optional: local dev convenience ---
# APP_PROFILES=local
# MODOCUMENT_MFA_REQUIRE_FOR_ADMIN=false

# --- Optional: AI (defaults in compose point at host Ollama when set in .env) ---
# AIFILES_OPENAI_APIKEY=ollama
# AIFILES_OPENAI_BASEURL=http://host.docker.internal:11434
# AIFILES_OPENAI_MODELID=qwen2.5
