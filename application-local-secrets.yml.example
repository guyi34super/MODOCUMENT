# Copy this file to application-local-secrets.yml (which is gitignored) and fill
# in a real signing key for local development. The `local` profile imports it
# automatically. Generate a key with:  openssl rand -base64 48
modocument:
  security:
    jwt:
      secret: replace-with-output-of-openssl-rand-base64-48

# --- Local Ollama (THE DEFAULT, gate C8) ---
# These match application.yml's own defaults, spelled out so they are easy to
# tweak. Prompts stay on this machine; pull the models once with
# `ollama pull qwen2.5 && ollama pull mistral && ollama pull deepseek-r1:8b`.
aifiles:
  openai:
    api-key: ollama
    base-url: http://localhost:11434
    model-id: qwen2.5                   # document table extraction / automap
# modocument:
#   extraction-llm:
#     model-id: mistral:latest          # schema inference, summaries, cleaning
#   chat-edit:
#     model-id: deepseek-r1:8b          # validation-step chat edits
# ocr:
#   vision:
#     enabled: false                    # off by default: images cannot be pseudonymised

# --- External OpenAI-compatible endpoint (EXPLICIT OPT-IN) ---
# Only tokenized/pseudonymised prompts are ever sent (see
# docs/security/ai-controls.md), but with an external endpoint they do leave
# the machine. Uncomment and fill in to opt in:
# aifiles:
#   openai:
#     api-key: <your-api-key>
#     base-url: https://openrouter.ai/api
#     model-id: moonshotai/kimi-k3
