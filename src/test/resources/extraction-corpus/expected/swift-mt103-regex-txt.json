{
  "name": "swift-mt103-regex-txt",
  "file": "swift-mt103.txt",
  "strategy": "FIELD_REGEX",
  "minConfidence": 0.8,
  "maxConfidence": 1.0,
  "note": "MT103-style messages: tag-anchored value patterns, yyMMdd dates, decimal comma amounts",
  "fields": [
    {
      "name": "Transaction Reference",
      "type": "TEXT",
      "valuePattern": ":20:([A-Z0-9]{12})"
    },
    {
      "name": "Value Date",
      "type": "DATE",
      "valuePattern": ":32A:(\\d{6})MUR",
      "dateFormats": [
        "yyMMdd"
      ]
    },
    {
      "name": "Amount",
      "type": "NUMBER",
      "valuePattern": ":32A:\\d{6}MUR(\\d+,\\d{2})"
    },
    {
      "name": "Ordering Customer",
      "type": "TEXT",
      "valuePattern": ":50K:/\\d+\\n([A-Z][A-Z ]+[A-Z])"
    }
  ],
  "rows": [
