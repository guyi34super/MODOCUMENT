<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.modocument</groupId>
    <artifactId>modocument</artifactId>
    <version>1.2.0</version>
    <name>MoDocument</name>
    <description>MoDocument document processing service</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.1</spring-ai.version>
        <aws-sdk.version>2.55.5</aws-sdk.version>
        <!-- see maven-surefire-plugin below -->
        <skipUTs>false</skipUTs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Authentication: stateless JWT (HS256) issued by /api/auth/login,
             verified by the resource-server's BearerTokenAuthenticationFilter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Argon2id password hashing (SEC-018): spring-security-crypto's
             Argon2PasswordEncoder delegates to BouncyCastle's Argon2 impl -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <!-- OIDC front door (ws07): Entra ID / Keycloak authenticate the
             browser, then MoDocument issues its OWN tokens (bridge pattern).
             Purely additive: with no modocument.oidc.providers configured, no
             ClientRegistrationRepository bean exists and oauth2Login stays off. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- Database drivers: PostgreSQL for production, H2 for local/test profiles -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Bank integration hub (ws25, SE4): JDBC drivers of the bank
             databases a DATABASE connection may target. Runtime scope - the
             connector loads them by class name for the vendor it builds the
             URL for (never DriverManager discovery). Versions pinned (equal
             to the Spring Boot 3.5.3 managed ones). MySQL is reached through
             the MariaDB Connector/J (LGPL-2.1), never the GPL MySQL driver.
             Licences: ojdbc11 Oracle Free Use Terms and Conditions (FUTC),
             mssql-jdbc MIT, mariadb-java-client LGPL-2.1. -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.7.0.25.01</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>12.10.0.jre11</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.3</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Connector core (docs/integration/connector-sharing.md): the ONE
             DATABASE / REST_API / SFTP / WEBHOOK implementation, shared with
             the on-prem agent. A sibling Maven project, NOT a reactor module:
             install it first (`mvn -B -f connector-core/pom.xml install`;
             CI, the Dockerfile and release.yml do). Same version as this pom
             (scripts/check-version-sync.sh). -->
        <dependency>
            <groupId>com.modocument</groupId>
            <artifactId>modocument-connector-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SFTP (ws25): Apache MINA SSHD (Apache-2.0), used through
             connector-core; declared here to pin the version and for the
             embedded SFTP server of the connector tests. -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <version>2.15.0</version>
            <exclusions>
                <!-- commons-logging is already bridged by spring-jcl; a second
                     org.apache.commons.logging copy would shadow it. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>jcl-over-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Schema migrations: Flyway owns the PostgreSQL schema in production
             (the H2 local/test profiles keep Hibernate ddl-auto: create) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Health endpoint for container/load-balancer probes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ws18 alert e-mail channel (EmailAlertChannel). Inert unless
             spring.mail.host AND modocument.alerts.email.to are configured:
             Boot only creates the JavaMailSender when spring.mail.host is
             set, and the channel is a no-op without one. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Bean Validation (C6): declarative request-schema checks (@Valid +
             constraint annotations on request DTOs) as the outer layer in
             front of the hand-written use-case validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- LLM access via Spring AI (OpenAI chat model + structured output) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Data extraction: the default build keeps extraction in the
             primary database (extraction.store=sql) or memory. MongoDB and
             Kafka (scale mode) live in the `scale` profile below (ws29) so
             the production jar carries neither driver. -->

        <!-- Data extraction web connector: jsoup parses fetched HTML (tables,
             links, text) fetched over plain HTTP. JavaScript rendering
             (Playwright, ~200 MB of bundled driver) was removed in ws29;
             renderJs sources fall back to the plain fetch. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>

        <!-- File store (ws29): uploads, exports and doc assets on S3 when
             modocument.storage.backend=s3 (ECS). Sync Apache HTTP client
             only: the SDK's default Netty async client is excluded. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
            <exclusions>
                <!-- commons-logging is bridged by spring-jcl -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- File parsing: xlsx / csv / pdf / doc -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>5.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
            <exclusions>
                <!-- ws29: spring-jcl already provides the commons-logging
                     API; the second copy only made Spring warn at startup. -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- OCR fallback for image-only PDFs; degrades gracefully when the
             native tesseract library is unavailable -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>5.13.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- OpenAPI contract generated from code at /v3/api-docs (all
             profiles, OpenApiConfig); the bundled Swagger UI is enabled only
             by the local profile. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PostgreSQL integration suite (-Ppostgres-it, **/*PgIT.java):
             starts a disposable postgres:17 when MODOCUMENT_IT_JDBC_URL does
             not point at an external server (see PgItSupport). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- META-INF/build-info.properties → BuildProperties bean:
                         the generated OpenAPI contract (OpenApiConfig) takes
                         its title/version from the pom instead of hardcoding
                         them, and the public synthetic probe (ws18) reports
                         the same version. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Release identity (ws24): target/classes/git.properties →
                 Spring's GitProperties bean → GET /api/system/version
                 "commit". Offline (never contacts a remote) and tolerant:
                 a build without .git — the Docker build context excludes
                 it — simply has no git.properties, and the Dockerfile
                 writes a fallback one from its GIT_COMMIT build arg (and
                 skips this plugin). Only the properties the app reads are
                 computed. -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <verbose>false</verbose>
                    <offline>true</offline>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <!-- the one pattern GitProperties.getCommitTime() parses -->
                    <dateFormat>yyyy-MM-dd'T'HH:mm:ssZ</dateFormat>
                    <dateFormatTimeZone>UTC</dateFormatTimeZone>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                        <includeOnlyProperty>^git.build.time$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <!-- In-app release notes (ws24): CHANGELOG.md is packaged as
                 classpath:release/CHANGELOG.md for
                 GET /api/system/release-notes (ReleaseNotesCatalog). A build
                 without the file just serves no releases. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>release-notes</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/release</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>CHANGELOG.md</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- -DskipUTs=true skips ONLY the unit run (surefire) while
                         failsafe still runs: CI's backend-postgres and
                         storage-s3 jobs run their IT suites without repeating
                         the unit suite the build-and-test job already ran. -->
                    <skip>${skipUTs}</skip>
                    <!-- The PostgreSQL integration classes (*PgIT) belong to
                         failsafe in the postgres-it profile, never to the
                         default H2 unit run. -->
                    <excludes>
                        <exclude>**/*PgIT.java</exclude>
                        <exclude>**/*ConnIT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -B verify -Pcoverage — code coverage (ws19; a profile since
             ws29 so local runs and the IT jobs don't pay for the agent): the
             agent instruments the unit run and `report` renders
             target/site/jacoco/ at verify. CI's build-and-test job enables
             it. Deliberately NO <check> threshold gate yet — the baseline
             must be established and agreed first (see
             docs/security/branch-protection.md); CI prints the summary from
             jacoco.csv so the number is visible on every run. -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- mvn -B -Pscale package — scale-mode extraction (ws29): MongoDB
             store + Kafka wake-up bus, for SPRING_PROFILES_ACTIVE=scale. The
             default (production) jar ships neither driver; the Mongo/Kafka
             adapters live in src/scale/java and only compile here. The base
             application.yml excludes the Mongo/Kafka auto-configuration and
             application-scale.yml re-enables it. A default jar started with
             the scale profile fails fast (ScaleModeGuard). -->
        <profile>
            <id>scale</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-data-mongodb</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.kafka</groupId>
                    <artifactId>spring-kafka</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>scale-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/scale/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>scale-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/scale-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- mvn -B verify -Ps3-it -DskipUTs=true — the FileStore contract
             suite (ws29, src/s3-it/java/**/*S3IT.java) against S3FileStore
             on a Testcontainers Adobe S3Mock (a generic container, no extra
             module). Needs Docker (CI storage-s3 job). -->
        <profile>
            <id>s3-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>s3-it-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/s3-it/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*S3IT.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- mvn -B verify -Ppostgres-it — runs the real-PostgreSQL suite
             (Flyway/RLS/tenant-isolation gate) via failsafe, on an external
             server when MODOCUMENT_IT_JDBC_URL (+ MODOCUMENT_IT_SUPERUSER /
             MODOCUMENT_IT_SUPERUSER_PASSWORD) is set, otherwise on a
             Testcontainers postgres:17 (requires Docker, as on CI). -->
        <profile>
            <id>postgres-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*PgIT.java</include>
                            </includes>
                            <groups>postgres</groups>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- mvn -B verify -Pconnectors-it — the live connector contract suite
             (ws25, src/test/java/com/modocument/connectorsit/*ConnIT.java):
             the DATABASE connector against Testcontainers Oracle Free, SQL
             Server and MariaDB. Needs Docker (CI); excluded from the default
             build, and its Testcontainers modules are test-scoped here only. -->
        <profile>
            <id>connectors-it</id>
            <dependencies>
                <dependency>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>oracle-free</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mssqlserver</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>mariadb</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>connectors-it-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/connectors-it/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*ConnIT.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- mvn -B -DskipTests package -Psbom — CycloneDX SBOM (gate E8,
             SUP-S05). CI-only by design (.github/workflows/sbom.yml) so the
             everyday local `mvn verify` pays nothing for it; the BOM lands in
             target/bom.json / target/bom.xml. -->
        <profile>
            <id>sbom</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.1</version>
                        <configuration>
                            <projectType>application</projectType>
                            <outputFormat>all</outputFormat>
                        </configuration>
                        <executions>
                            <execution>
                                <id>cyclonedx-sbom</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
